@page "/match-history"
@attribute [Authorize]
@using Checkers.Shared.Enums

<PageTitle>Match History</PageTitle>

<RadzenStack Gap="1rem" Style="padding: 1rem;">
    <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1">Match History</RadzenText>

    @if (activeMatches is { Count: > 0 })
    {
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Gap="0.75rem">
                <RadzenText TextStyle="TextStyle.H6" TagName="TagName.H2">Active matches</RadzenText>
                @foreach (var active in activeMatches)
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.5rem">
                        <RadzenStack Gap="0">
                            <RadzenText TextStyle="TextStyle.Body1" Style="margin: 0;">
                                <strong>@(active.OpponentName is null ? "Waiting for an opponent" : $"vs {active.OpponentName}")</strong>
                                · playing @active.PlayedAs · code @active.MatchCode
                            </RadzenText>
                            <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0;">@ActiveStatus(active)</RadzenText>
                        </RadzenStack>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                            <RadzenButton Text="Rejoin" Icon="login" Size="ButtonSize.Small" Disabled="@busy"
                                          ButtonStyle="@(active.IsYourTurn ? ButtonStyle.Primary : ButtonStyle.Secondary)"
                                          Click="@(() => Rejoin(active))" />
                            @if (active.Status == SessionStatus.InProgress)
                            {
                                <RadzenButton Text="Surrender" Icon="flag" Size="ButtonSize.Small" Disabled="@busy"
                                              ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined"
                                              Click="@(() => Surrender(active))" />
                            }
                        </RadzenStack>
                    </RadzenStack>
                }
                @if (activeError is not null)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" Shade="Shade.Lighter">@activeError</RadzenAlert>
                }
            </RadzenStack>
        </RadzenCard>
    }

    @if (loading)
    {
        <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" AriaLabel="loading" />
    }
    else if (history is null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">
            Your match history couldn't be loaded. Please try again later.
        </RadzenAlert>
    }
    else
    {
        <RadzenStack Orientation="Orientation.Horizontal" Gap="2rem">
            <RadzenText TextStyle="TextStyle.H6">Wins: @history.Wins</RadzenText>
            <RadzenText TextStyle="TextStyle.H6">Losses: @history.Losses</RadzenText>
            <RadzenText TextStyle="TextStyle.H6">Draws: @history.Draws</RadzenText>
        </RadzenStack>

        @if (history.Matches.Count == 0)
        {
            <RadzenText TextStyle="TextStyle.Body1">You haven't played any matches yet.</RadzenText>
        }
        else
        {
            <RadzenDataGrid Data="@history.Matches" TItem="MatchSummaryDto" AllowSorting="true" AllowPaging="true" PageSize="10">
                <Columns>
                    <RadzenDataGridColumn TItem="MatchSummaryDto" Property="@nameof(MatchSummaryDto.EndedAtUtc)" Title="Date">
                        <Template Context="match">@match.EndedAtUtc.ToLocalTime().ToString("g")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MatchSummaryDto" Property="@nameof(MatchSummaryDto.OpponentName)" Title="Opponent" />
                    <RadzenDataGridColumn TItem="MatchSummaryDto" Property="@nameof(MatchSummaryDto.PlayedAs)" Title="Played As" />
                    <RadzenDataGridColumn TItem="MatchSummaryDto" Property="@nameof(MatchSummaryDto.Outcome)" Title="Result">
                        <Template Context="match">
                            <RadzenBadge BadgeStyle="@OutcomeStyle(match.Outcome)" Text="@match.Outcome.ToString()" />
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MatchSummaryDto" Title="Length" Sortable="false">
                        <Template Context="match">@Duration(match)</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MatchSummaryDto" Title="" Sortable="false" Width="8rem">
                        <Template Context="match">
                            <RadzenButton Text="Replay" Icon="replay" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light"
                                          Click="@(() => Navigation.NavigateTo($"match-history/{match.Id}"))" />
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    }
</RadzenStack>
