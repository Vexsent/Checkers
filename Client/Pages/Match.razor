@page "/match"
@attribute [Authorize]
@using Checkers.Client.Components.Board
@using Checkers.Shared.Enums
@using Microsoft.AspNetCore.SignalR.Client
@implements IDisposable

<PageTitle>Play a Match</PageTitle>

<div class="@(Session is null ? "match-page setup" : "match-page playing")">
    @if (Session is null)
    {
        <div class="setup-title">
            <h1>Play a Match</h1>
            <p>Play the computer, or another player by sharing the match code.</p>
        </div>

        <div class="setup-grid">
            <section class="setup-panel" aria-labelledby="new-match">
                <div class="setup-panel-head">
                    <h2 id="new-match">@(showRuleEditor ? "Customize rules" : "New match")</h2>
                    <RadzenLink Path="rules" Text="Rules help" class="rules-help" />
                    <RadzenButton Text="@(showRuleEditor ? "Back" : "Customize rules")" Icon="@(showRuleEditor ? "arrow_back" : "tune")"
                                  Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Click="@(() => showRuleEditor = !showRuleEditor)" />
                </div>

                <div class="setup-panel-body">
                    @if (!showRuleEditor)
                    {
                        <div class="setup-fields">
                            <div class="field">
                                <RadzenLabel Text="Opponent" Component="opponent" />
                                <RadzenDropDown @bind-Value="@OpponentKey" TValue="int" Data="@OpponentChoices" Name="opponent"
                                                TextProperty="Text" ValueProperty="Key" Style="width: 100%;" />
                            </div>

                            <div class="field">
                                <RadzenLabel Text="Play as" Component="creator-color" />
                                <RadzenSelectBar @bind-Value="@creatorColor" TValue="ColorChoice" Name="creator-color" Size="ButtonSize.Small">
                                    <Items>
                                        <RadzenSelectBarItem Text="@ColorLabel(PlayerColor.Black)" Value="ColorChoice.Black" />
                                        <RadzenSelectBarItem Text="@ColorLabel(PlayerColor.White)" Value="ColorChoice.White" />
                                        <RadzenSelectBarItem Text="Random" Value="ColorChoice.Random" />
                                    </Items>
                                </RadzenSelectBar>
                            </div>

                            <div class="field field-wide">
                                <RadzenLabel Text="Game type" Component="game-type" />
                                <RadzenDropDown @bind-Value="@SelectedVariant" TValue="GameVariant" Data="@VariantChoices" Name="game-type"
                                                TextProperty="@nameof(VariantChoice.Name)" ValueProperty="@nameof(VariantChoice.Variant)" Style="width: 100%; max-width: 22rem;" />
                                <RadzenText TextStyle="TextStyle.Caption" class="field-note variant-note">@VariantDescription <RadzenLink Path="rules" Text="What do these rules mean?" /></RadzenText>
                            </div>

                            <div class="field field-wide">
                                <div class="field-inline">
                                    <RadzenSwitch @bind-Value="@useTurnLimit" Name="turn-limit" />
                                    <RadzenLabel Text="Turn limit" Component="turn-limit" />
                                    @if (useTurnLimit)
                                    {
                                        <RadzenNumeric @bind-Value="@turnLimitAmount" TValue="int" Min="1" Style="width: 4.25rem;" aria-label="Turn time limit amount" />
                                        <RadzenDropDown @bind-Value="@turnLimitUnitSeconds" TValue="int" Data="@TurnLimitUnits"
                                                        TextProperty="@nameof(TurnLimitUnit.Name)" ValueProperty="@nameof(TurnLimitUnit.Seconds)"
                                                        Style="width: 6.5rem;" aria-label="Turn time limit unit" />
                                    }
                                </div>
                                @if (useTurnLimit)
                                {
                                    <RadzenText TextStyle="TextStyle.Caption" class="@(TurnLimitError is null ? "field-note limit-note" : "field-note")" Style="@(TurnLimitError is null ? null : "color: var(--rz-danger);")">
                                        @(TurnLimitError ?? "30 seconds to 1 week. Run out of time and you resign.")
                                    </RadzenText>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="setup-fields">
                            <div class="field">
                                <RadzenLabel Text="Game type" Component="game-type-custom" />
                                <RadzenDropDown @bind-Value="@SelectedVariant" TValue="GameVariant" Data="@VariantChoices" Name="game-type-custom"
                                                TextProperty="@nameof(VariantChoice.Name)" ValueProperty="@nameof(VariantChoice.Variant)" Style="width: 100%;" />
                            </div>
                            <div class="field field-inline-group">
                                <div class="field">
                                    <RadzenLabel Text="Board" Component="board-size" />
                                    <RadzenDropDown @bind-Value="@BoardSize" TValue="int" Data="@BoardSizes" Name="board-size"
                                                    TextProperty="Text" ValueProperty="Value" Style="width: 7.5rem;" />
                                </div>
                                <div class="field">
                                    <RadzenLabel Text="Rows of men" Component="piece-rows" />
                                    <RadzenNumeric @bind-Value="@PieceRows" TValue="int" Min="1" Max="@(BoardSize / 2 - 1)" Name="piece-rows" Style="width: 5.5rem;" />
                                </div>
                                <div class="field">
                                    <RadzenLabel Text="Moves first" Component="first-player" />
                                    <RadzenSelectBar @bind-Value="@FirstPlayer" TValue="PlayerColor" Name="first-player" Size="ButtonSize.Small">
                                        <Items>
                                            <RadzenSelectBarItem Text="Black" Value="PlayerColor.Black" />
                                            <RadzenSelectBarItem Text="White" Value="PlayerColor.White" />
                                        </Items>
                                    </RadzenSelectBar>
                                </div>
                            </div>

                            <div class="field">
                                <RadzenLabel Text="When several captures are possible" Component="capture-choice" />
                                <RadzenDropDown @bind-Value="@CaptureChoiceValue" TValue="CaptureChoice" Data="@CaptureChoices" Name="capture-choice"
                                                TextProperty="Text" ValueProperty="Value" Style="width: 100%;" />
                            </div>
                            <div class="field">
                                <RadzenLabel Text="A man reaching the far row mid-capture" Component="promotion" />
                                <RadzenDropDown @bind-Value="@Promotion" TValue="PromotionRule" Data="@PromotionChoices" Name="promotion"
                                                TextProperty="Text" ValueProperty="Value" Style="width: 100%;" />
                            </div>

                            <div class="switch-grid field-wide">
                            <div class="field-inline">
                                <RadzenSwitch @bind-Value="@ForcedCaptures" Name="forced-captures" />
                                <RadzenLabel Text="Forced captures" Component="forced-captures" />
                            </div>
                            <div class="field-inline">
                                <RadzenSwitch @bind-Value="@MenCaptureBackward" Name="men-backward" />
                                <RadzenLabel Text="Men capture backwards" Component="men-backward" />
                            </div>
                            <div class="field-inline">
                                <RadzenSwitch @bind-Value="@MenCanCaptureKings" Name="men-kings" />
                                <RadzenLabel Text="Men can capture kings" Component="men-kings" />
                            </div>
                            <div class="field-inline">
                                <RadzenSwitch @bind-Value="@RemoveCapturedAtEndOfMove" Name="remove-end" />
                                <RadzenLabel Text="Captured pieces stay until the move ends" Component="remove-end" />
                            </div>
                            <div class="field-inline">
                                <RadzenSwitch @bind-Value="@FlyingKings" Name="flying-kings" />
                                <RadzenLabel Text="Flying kings" Component="flying-kings" />
                            </div>
                            @if (FlyingKings)
                            {
                                <div class="field-inline">
                                    <RadzenSwitch @bind-Value="@KingStopsBehindCapture" Name="king-stops" />
                                    <RadzenLabel Text="King lands right behind a capture" Component="king-stops" />
                                </div>
                            }
                            </div>
                            <RadzenText TextStyle="TextStyle.Caption" class="field-note field-wide editor-note">
                                Multi-jumps that have started must always be finished. <RadzenLink Path="rules" Text="What do these rules mean?" />
                            </RadzenText>
                        </div>
                    }
                </div>

                <div class="setup-panel-foot">
                    <RadzenButton Text="@(vsComputer ? "Play the computer" : "Create match")" Icon="@(vsComputer ? "smart_toy" : "add")"
                                  Disabled="@(busy || TurnLimitError is not null)" Click="@CreateMatch" />
                    <span class="setup-summary">@MatchTimeText.DescribeRules(rules, useTurnLimit && TurnLimitError is null ? (int)TurnLimitSeconds : null)</span>
                </div>
            </section>

            <section class="setup-panel join-panel" aria-labelledby="join-match">
                <h2 id="join-match">Join a match</h2>
                <p>Enter the code your opponent gave you.</p>
                <div class="join-row">
                    <RadzenTextBox @bind-Value="@joinCode" Immediate="true" Placeholder="Match code" MaxLength="6" aria-label="Match code" Style="flex: 1; min-width: 0;" />
                    <RadzenButton Text="Join" Icon="login" ButtonStyle="ButtonStyle.Secondary" Disabled="@(busy || string.IsNullOrWhiteSpace(joinCode))" Click="@JoinMatch" />
                </div>
            </section>
        </div>
    }
    else
    {
        <div class="match-header">
            <div>
                @if (Session.ComputerColor is null)
                {
                    <div class="match-code">Match code: <strong>@Session.MatchCode</strong></div>
                }
                <div>Black: @(Session.BlackPlayerName ?? "waiting…")@(Session.BlackPlayerId == myUserId ? " (you)" : "") · White: @(Session.WhitePlayerName ?? "waiting…")@(Session.WhitePlayerId == myUserId ? " (you)" : "")</div>
                <div class="match-rules">@MatchTimeText.DescribeRules(Session.Rules, Session.TurnTimeLimitSeconds)</div>
                <div class="match-status">@StatusText</div>
                @if (Session.Status == SessionStatus.InProgress && Session.TurnDeadlineUtc is { } deadline)
                {
                    var remaining = deadline - DateTime.UtcNow;
                    <div class="@(remaining < TimeSpan.FromSeconds(10) ? "turn-clock turn-clock-low" : "turn-clock")" role="timer" aria-live="off">
                        @(IsMyTurn ? "Your time left" : "Opponent's time left"): @MatchTimeText.Remaining(remaining)
                    </div>
                }
                @if (Session.Status == SessionStatus.Finished)
                {
                    <RadzenLink Path="match-history" Text="See this game in your match history" />
                }
            </div>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                @if (Session.Status == SessionStatus.InProgress)
                {
                    <RadzenButton Text="Offer draw" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Secondary" Disabled="@(busy || Session.DrawOfferedBy is not null)" Click="@OfferDraw" />
                    <RadzenButton Text="Resign" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Disabled="@busy" Click="@Resign" />
                }
                <RadzenButton Text="Leave" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Disabled="@busy" Click="@Leave" />
            </RadzenStack>
        </div>

        <div class="match-alerts">
        @if (Sessions.ConnectionState == HubConnectionState.Reconnecting)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false" Shade="Shade.Lighter">Connection lost. Reconnecting…</RadzenAlert>
        }
        else if (Sessions.ConnectionState == HubConnectionState.Disconnected)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" Shade="Shade.Lighter">
                Disconnected from the game server.
                <RadzenButton Text="Rejoin" Size="ButtonSize.Small" Disabled="@busy" Click="@Rejoin" />
            </RadzenAlert>
        }
        else if (!Sessions.IsOpponentConnected && Session.Status == SessionStatus.InProgress)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false" Shade="Shade.Lighter">Your opponent has disconnected.</RadzenAlert>
        }

        @if (Session.Status == SessionStatus.InProgress && OpponentOfferedDraw)
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false" Shade="Shade.Lighter">
                Your opponent offers a draw.
                <RadzenButton Text="Accept" Size="ButtonSize.Small" Disabled="@busy" Click="@(() => AnswerDraw(true))" />
                <RadzenButton Text="Decline" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Disabled="@busy" Click="@(() => AnswerDraw(false))" />
            </RadzenAlert>
        }
        else if (Session.Status == SessionStatus.InProgress && IOfferedDraw)
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false" Shade="Shade.Lighter">Draw offered. Waiting for your opponent to answer.</RadzenAlert>
        }
        else if (Session.Status == SessionStatus.InProgress && drawNotice is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false" Shade="Shade.Lighter">@drawNotice</RadzenAlert>
        }
        </div>

        <div class="match-body">
            <div class="match-board">
                <BoardView Board="@CurrentBoard" Selected="@Selected" Highlighted="@Highlighted" OnSquareClicked="@SquareClicked" Flipped="@(MyColor == PlayerColor.Black)"
                           Rejected="@rejected" RejectedCount="@rejectedCount" Hints="@Hints" />
            </div>
            <section class="move-list" aria-label="Moves">
                <h2>Moves</h2>
                @if (MoveList.Moves.Count == 0)
                {
                    <p>No moves yet.</p>
                }
                else
                {
                    <ol>
                        @foreach (var entry in MoveList.Moves)
                        {
                            <li value="@entry.Number">@entry.Text</li>
                        }
                    </ol>
                }
            </section>
        </div>
    }

    @if (error is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" Shade="Shade.Lighter">@error</RadzenAlert>
    }
</div>
