@page "/match"
@attribute [Authorize]
@using Checkers.Client.Components.Board
@using Checkers.Shared.Enums
@using Microsoft.AspNetCore.SignalR.Client
@implements IDisposable

<PageTitle>Play a Match</PageTitle>

<div class="match-page">
    @if (Session is null)
    {
        <h1>Play a Match</h1>
        <RadzenStack Gap="1.5rem">
            <RadzenStack Gap="0.5rem">
                <p>Start a match and share its code with your opponent.</p>
                <RadzenFieldset Text="Match settings">
                    <RadzenStack Gap="1rem">
                        <RadzenStack Gap="0.25rem">
                            <RadzenLabel Text="Play as" Component="creator-color" />
                            <RadzenSelectBar @bind-Value="@creatorColor" TValue="ColorChoice" Name="creator-color" Size="ButtonSize.Small">
                                <Items>
                                    <RadzenSelectBarItem Text="Black (moves first)" Value="ColorChoice.Black" />
                                    <RadzenSelectBarItem Text="White" Value="ColorChoice.White" />
                                    <RadzenSelectBarItem Text="Random" Value="ColorChoice.Random" />
                                </Items>
                            </RadzenSelectBar>
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenSwitch @bind-Value="@forcedCaptures" Name="forced-captures" />
                                <RadzenLabel Text="Forced captures" Component="forced-captures" />
                            </RadzenStack>
                            <RadzenText TextStyle="TextStyle.Caption">@(forcedCaptures ? "A player who can capture must." : "Capturing is optional, but a multi-jump that's started must be finished.")</RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="0">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenSwitch @bind-Value="@flyingKings" Name="flying-kings" />
                                <RadzenLabel Text="Flying kings" Component="flying-kings" />
                            </RadzenStack>
                            <RadzenText TextStyle="TextStyle.Caption">@(flyingKings ? "Kings move and capture any distance along a diagonal." : "Kings move one square at a time, forwards or backwards.")</RadzenText>
                        </RadzenStack>

                        <RadzenStack Gap="0.25rem">
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                <RadzenSwitch @bind-Value="@useTurnLimit" Name="turn-limit" />
                                <RadzenLabel Text="Turn time limit" Component="turn-limit" />
                            </RadzenStack>
                            @if (useTurnLimit)
                            {
                                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                                    <RadzenNumeric @bind-Value="@turnLimitAmount" TValue="int" Min="1" Style="width: 7rem;" aria-label="Turn time limit amount" />
                                    <RadzenDropDown @bind-Value="@turnLimitUnitSeconds" TValue="int" Data="@TurnLimitUnits"
                                                    TextProperty="@nameof(TurnLimitUnit.Name)" ValueProperty="@nameof(TurnLimitUnit.Seconds)"
                                                    Style="width: 8rem;" aria-label="Turn time limit unit" />
                                </RadzenStack>
                                <RadzenText TextStyle="TextStyle.Caption">
                                    Anywhere from 30 seconds to 1 week. A player who doesn't finish their turn in time automatically resigns.
                                </RadzenText>
                                @if (TurnLimitError is { } limitError)
                                {
                                    <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-danger);">@limitError</RadzenText>
                                }
                            }
                        </RadzenStack>
                    </RadzenStack>
                </RadzenFieldset>
                <RadzenButton Text="Create match" Icon="add" Disabled="@(busy || TurnLimitError is not null)" Click="@CreateMatch" />
            </RadzenStack>
            <RadzenStack Gap="0.5rem">
                <p>Or enter the code your opponent gave you.</p>
                <RadzenTextBox @bind-Value="@joinCode" Immediate="true" Placeholder="Match code" MaxLength="6" aria-label="Match code" />
                <RadzenButton Text="Join match" Icon="login" ButtonStyle="ButtonStyle.Secondary" Disabled="@(busy || string.IsNullOrWhiteSpace(joinCode))" Click="@JoinMatch" />
            </RadzenStack>
        </RadzenStack>
    }
    else
    {
        <div class="match-header">
            <div>
                <div class="match-code">Match code: <strong>@Session.MatchCode</strong></div>
                <div>Black: @(Session.BlackPlayerName ?? "waiting…")@(Session.BlackPlayerId == myUserId ? " (you)" : "") · White: @(Session.WhitePlayerName ?? "waiting…")@(Session.WhitePlayerId == myUserId ? " (you)" : "")</div>
                <div class="match-rules">@MatchTimeText.DescribeRules(Session.Rules, Session.TurnTimeLimitSeconds)</div>
                <div class="match-status">@StatusText</div>
                @if (Session.Status == SessionStatus.InProgress && Session.TurnDeadlineUtc is { } deadline)
                {
                    var remaining = deadline - DateTime.UtcNow;
                    <div class="@(remaining < TimeSpan.FromSeconds(10) ? "turn-clock turn-clock-low" : "turn-clock")" role="timer" aria-live="off">
                        @(IsMyTurn ? "Your time left" : "Opponent's time left"): @MatchTimeText.Remaining(remaining)
                    </div>
                }
                @if (Session.Status == SessionStatus.Finished)
                {
                    <RadzenLink Path="match-history" Text="See this game in your match history" />
                }
            </div>
            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                @if (Session.Status == SessionStatus.InProgress)
                {
                    <RadzenButton Text="Offer draw" ButtonStyle="ButtonStyle.Secondary" Disabled="@(busy || Session.DrawOfferedBy is not null)" Click="@OfferDraw" />
                    <RadzenButton Text="Resign" ButtonStyle="ButtonStyle.Danger" Disabled="@busy" Click="@Resign" />
                }
                <RadzenButton Text="Leave" ButtonStyle="ButtonStyle.Light" Disabled="@busy" Click="@Leave" />
            </RadzenStack>
        </div>

        @if (Sessions.ConnectionState == HubConnectionState.Reconnecting)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false" Shade="Shade.Lighter">Connection lost. Reconnecting…</RadzenAlert>
        }
        else if (Sessions.ConnectionState == HubConnectionState.Disconnected)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" Shade="Shade.Lighter">
                Disconnected from the game server.
                <RadzenButton Text="Rejoin" Size="ButtonSize.Small" Disabled="@busy" Click="@Rejoin" />
            </RadzenAlert>
        }
        else if (!Sessions.IsOpponentConnected && Session.Status == SessionStatus.InProgress)
        {
            <RadzenAlert AlertStyle="AlertStyle.Warning" AllowClose="false" Shade="Shade.Lighter">Your opponent has disconnected.</RadzenAlert>
        }

        @if (Session.Status == SessionStatus.InProgress && OpponentOfferedDraw)
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false" Shade="Shade.Lighter">
                Your opponent offers a draw.
                <RadzenButton Text="Accept" Size="ButtonSize.Small" Disabled="@busy" Click="@(() => AnswerDraw(true))" />
                <RadzenButton Text="Decline" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" Disabled="@busy" Click="@(() => AnswerDraw(false))" />
            </RadzenAlert>
        }
        else if (Session.Status == SessionStatus.InProgress && IOfferedDraw)
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false" Shade="Shade.Lighter">Draw offered. Waiting for your opponent to answer.</RadzenAlert>
        }
        else if (Session.Status == SessionStatus.InProgress && drawNotice is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Info" AllowClose="false" Shade="Shade.Lighter">@drawNotice</RadzenAlert>
        }

        <div class="match-body">
            <div class="match-board">
                <BoardView Board="@CurrentBoard" Selected="@Selected" Highlighted="@Highlighted" OnSquareClicked="@SquareClicked" />
            </div>
            <section class="move-list" aria-label="Moves">
                <h2>Moves</h2>
                @if (MoveList.Moves.Count == 0)
                {
                    <p>No moves yet.</p>
                }
                else
                {
                    <ol>
                        @foreach (var entry in MoveList.Moves)
                        {
                            <li value="@entry.Number">@entry.Text</li>
                        }
                    </ol>
                }
            </section>
        </div>
    }

    @if (error is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" Shade="Shade.Lighter">@error</RadzenAlert>
    }
</div>
