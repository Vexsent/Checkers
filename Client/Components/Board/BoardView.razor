@using Checkers.Shared.Enums
@implements IDisposable

<div class="board" style="@GridStyle">
    @for (int r = 0; r < Board.Size; r++)
    {
        for (int c = 0; c < Board.Size; c++)
        {
            // Screen position (r, c) shows board square (row, col): the same square, or the one
            // opposite it when the board is turned round for the Black player.
            int row = Flipped ? Board.Size - 1 - r : r;
            int col = Flipped ? Board.Size - 1 - c : c;
            var image = PieceImages.For(Board[row, col]);
            <div @key="@SquareKey(row, col)" class="@SquareClass(row, col)" @onclick="() => SquareClicked(row, col)">
                @if (image is not null)
                {
                    <img class="checker-piece-img" src="@image" alt="@Board[row, col]" />
                }
            </div>
        }
    }
</div>
