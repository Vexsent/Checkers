@using System.Security.Claims;
@inherits LayoutComponentBase

<RadzenLayout>
    <AuthorizeView>
        <Authorizing>
            <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" AriaLabel="Primary loading" />
        </Authorizing>
    <Authorized>
        <RadzenLayoutTemplate Style="font-size: 1rem" User="@("Welcome " + context.User.Identity?.Name)">
            <RadzenHeader>
                Checkers
            </RadzenHeader>
            <RadzenBody>
                @Body
            </RadzenBody>
            <RadzenSidebar @bind-Expanded="@sidebarExpanded" Style="width: 250px;">
                <Sidebar />
            </RadzenSidebar>
        </RadzenLayoutTemplate>
    </Authorized>
    <NotAuthorized>
         <RadzenButton Icon="menu" title="Sign Up" Size="ButtonSize.Small" Click="@(() => OpenRegisterDialog())" />
    </NotAuthorized>
</AuthorizeView>
    <RadzenFooter Style="height: 60px;">
        <div class="d-flex align-items-center justify-content-between h-100 px-4">
            <span>&copy; 2024 - My Application</span>
        </div>
    </RadzenFooter>
</RadzenLayout>


