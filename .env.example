# Copy to .env on the server and fill in. .env is git-ignored; never commit real values.

# Host port the server listens on. Point the reverse proxy at http://<server-ip>:<this port>.
CHECKERS_PORT=8080

# Connection string for the existing SQL Server.
CHECKERS_DB_CONNECTION=Server=192.168.1.216,1433;Database=Checkers;User Id=<user>;Password=<password>;TrustServerCertificate=True

# Signs login tokens. At least 32 random bytes, e.g.: openssl rand -base64 48
# Changing it signs everyone out.
CHECKERS_JWT_SIGNING_KEY=<generate-a-random-key>
